{
  "name": "rulewright",
  "private": true,
  "version": "0.1.0",
  "description": "Turn recurring corrections into reviewable, machine-checkable rules.",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "npm run build -w apps/studio"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "fast-check": "^3.23.2",
    "puppeteer-core": "^23.11.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
