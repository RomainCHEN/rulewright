{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vitest/globals", "node"],
    "baseUrl": ".",
    "paths": { "@rulewright/core": ["packages/rule-core/src/index.ts"] }
  },
  "include": ["packages/**/*.ts", "apps/**/*.ts", "vitest.config.ts"]
}
